# Wrench ERP-Oficina — variáveis de ambiente (copie para .env)
# O docker-compose.yml lê estas variáveis. Defaults já estão definidos inline.

# Porta do frontend no host
FRONTEND_PORT=3000

# URL do backend que o frontend vai chamar (do ponto de vista do navegador).
# Em dev local (bun dev): http://localhost:5012
# Em container: http://localhost:5012 (backend exposto no host) ou http://backend:8080 (rede interna)
NEXT_PUBLIC_API_URL=http://localhost:5012

# Porta do backend .NET no host (entra na Fase 4)
BACKEND_PORT=5012

# PostgreSQL — porta no host (5434: Indagor=5432, RFClub=5433, Wrench=5434)
POSTGRES_PORT=5434

# Redis — porta no host
REDIS_PORT=6380
