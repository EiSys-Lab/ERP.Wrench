# ============================================================
#  Wrench ERP-Oficina — .gitignore
# ============================================================

# ─── Node / Frontend ─────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
.yarn/cache
.yarn/install-state.gz
bun.lockb

# Next.js
.next/
out/
build/
dist/
.vercel/

# ─── .NET / Backend (Fase 4) ─────────────────────────────────
bin/
obj/
*.user
*.suo
*.userprefs
*.cache
*.dll
*.pdb
*.exe
artifacts/
TestResults/
*.trx
*.coverage
*.coveragexml

# NuGet
*.nupkg
*.snupkg
.nuget/

# ─── Ambientes / Secrets ─────────────────────────────────────
.env
.env.*
!.env.example
*.env
secrets/
.mcp.json

# Certificados e chaves (NUNCA commitar)
*.pfx
*.p12
*.pem
*.key
*.crt
*.cer
*.jks

# ─── Python (análise do Excel, scripts auxiliares) ───────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
.python-version
.ipynb_checkpoints/

# ─── Docker / Infra ──────────────────────────────────────────
# volumes locais nomeados não vão pro repo
postgres-data/
redis-data/

# ─── IDEs / Editores ─────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.cursor/
.zcode/tmp/
.zcode/v2/
.zcode/workspace/
.eisys/cache/
.eisys/tmp/

# JetBrains
.idea/

# Visual Studio
.vs/

# ─── OS / Sistema ────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ─── Logs ────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Tipografia / Assets grandes ─────────────────────────────
# (não commitar fontes/binários grandes se houver)
*.ttf
*.otf
*.woff
*.woff2
!src/frontend/public/fonts/**

# ─── Coverage / Testes ───────────────────────────────────────
coverage/
*.lcov
.nyc_output/

# ─── Temporários ─────────────────────────────────────────────
*.tmp
*.temp
*.bak
*.old

# ─── TypeScript ──────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Playwright (testes E2E) ─────────────────────────────────
test-results/
playwright-report/
blob-report/
.playwright/

# ─── Documentos sensíveis do cliente (NÃO commitar) ──────────
Conversa-Cliente/
uploads/

# Excel com dados reais de clientes/placas/faturamento (LGPD) — não commitar
*.xlsx
*.xls
*.xlsm
!Docs/**.xlsx
